---
import Layout from '../layouts/Layout.astro';

const experience = [
  {
    company: "Tech Company Inc.",
    position: "Senior Software Engineer",
    period: "2021 - Present",
    description: "Leading development of scalable microservices and mentoring junior developers.",
    highlights: [
      "Architected and deployed microservices handling 1M+ daily requests",
      "Led team of 5 engineers on key product initiatives",
      "Reduced CI/CD pipeline time by 60% through optimization",
      "Implemented monitoring and alerting reducing incident response time by 40%"
    ]
  },
  {
    company: "Startup Labs",
    position: "Software Engineer",
    period: "2019 - 2021",
    description: "Full-stack development for B2B SaaS platform.",
    highlights: [
      "Built React dashboard serving 500+ enterprise clients",
      "Designed and implemented real-time data processing pipeline",
      "Collaborated with design team to improve user experience",
      "Wrote comprehensive test suites increasing code coverage to 85%"
    ]
  },
  {
    company: "Digital Agency Co.",
    position: "Junior Developer",
    period: "2018 - 2019",
    description: "Developed websites and web applications for various clients.",
    highlights: [
      "Built responsive websites for 20+ clients",
      "Maintained and improved legacy codebases",
      "Participated in code reviews and agile ceremonies"
    ]
  }
];

const education = [
  {
    school: "University of Technology",
    degree: "Bachelor of Science in Computer Science",
    period: "2014 - 2018",
    details: "GPA: 3.8/4.0 | Dean's List | Relevant coursework: Data Structures, Algorithms, Web Development, Database Systems"
  }
];
---

<Layout title="Experience - Jake Smith" active="Experience">
  <section class="section">
    <div class="container">
      <h1 class="section-title">Experience</h1>

      <div class="timeline">
        {experience.map((job, index) => (
          <div class="timeline-item">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
              <div class="job-header">
                <div>
                  <h2>{job.position}</h2>
                  <p class="company">{job.company}</p>
                </div>
                <span class="period">{job.period}</span>
              </div>
              <p class="description">{job.description}</p>
              <ul class="highlights">
                {job.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section education-section">
    <div class="container">
      <h2 class="section-title">Education</h2>

      {education.map((edu) => (
        <div class="education-card">
          <div class="edu-header">
            <div>
              <h3>{edu.degree}</h3>
              <p class="school">{edu.school}</p>
            </div>
            <span class="period">{edu.period}</span>
          </div>
          <p class="details">{edu.details}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 3rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -2rem;
    top: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--gradient);
    transform: translateX(-5px);
  }

  .timeline-content {
    background: var(--bg-alt);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .job-header h2 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .company {
    color: var(--primary);
    font-weight: 500;
  }

  .period {
    color: var(--text-light);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .description {
    color: var(--text-light);
    margin-bottom: 1rem;
  }

  .highlights {
    padding-left: 1.25rem;
  }

  .highlights li {
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .highlights li:last-child {
    margin-bottom: 0;
  }

  .education-section {
    background: var(--bg-alt);
  }

  .education-card {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .edu-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .edu-header h3 {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
  }

  .school {
    color: var(--primary);
    font-weight: 500;
  }

  .details {
    color: var(--text-light);
  }

  @media (max-width: 600px) {
    .job-header, .edu-header {
      flex-direction: column;
    }
  }
</style>
